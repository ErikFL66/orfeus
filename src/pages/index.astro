---
import PageLayouts from "../layouts/PageLayouts.astro";
import Card from "../components/Card.astro";
import Postkortet from "../images/vindue-et.jpg";
import Postkortto from "../images/vindue-to.jpg";
import Postkorttre from "../images/vindue-tre.jpg";
---

<PageLayouts>
	<div class="cards">
		<Card headline="´Det er rart at tale med nogen der forstår´" text="Postkort fra en pårørende" image={Postkortet} />
		<Card headline="´Man stopper aldrig med at være mor eller far´" text="Postkort fra en pårørende" image={Postkortto}/>
		<Card headline="´Ingen skal stå alene´" text="Postkort fra en pårørende" image={Postkorttre}/>
	</div>
</PageLayouts>

