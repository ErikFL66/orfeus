---
import { Image } from "astro:assets";

import Graphic from "../images/logolang.svg";
---

<footer>
    <div>
        <!-- spørg om det her -->
         <Image src={Graphic} alt="Logo" />
        <p>Rådgivningen Orgeus er en frivilligdrevet, lansdækkende rådgivning til mennesker, der har misbrug og afhængighed tæt ind på livet.</p>
    </div>
    <div>
        <h2>Kontakt</h2>
        <p>MAIL: kontakt@raadgivningen-orfeus.dk</p>
        <p>TLF: 70604640</p>
    </div>
</footer>

<style>
    footer {
        width: 100%;
        height: 50vh;
        display: grid;
        grid-template-columns: 1fr;
        padding: 10% 10% 0 10%;
        background-color: #444;
        color: #fff;
    }
    /*  */
    @media screen and (min-width: 768px) {
        footer {
            grid-template-columns: 2fr 1fr;
        }
    }
</style>
