---
import { Image } from "astro:assets";
import Logo from "../images/logolang.svg";
---

<body>
    <footer>
        <div>
            <!-- spørg om det her -->
            <Image src={Logo} alt="logo" />
            <p>Rådgivningen Orgeus er en frivilligdrevet, lansdækkende rådgivning til mennesker, der har misbrug og afhængighed tæt ind på livet.</p>
        </div>
        <div>
            <h3>Sociale medier</h3>
            <p>Facebook</p>
            <p>Instagram</p>
        </div>
        <div>
            <h2>Kontakt</h2>
            <p>MAIL: kontakt@raadgivningen-orfeus.dk</p>
            <p>TLF: 70604640</p>
        </div>
    </footer>
</body>

<style>
    footer {
        width: 100%;
        height: 50vh;
        display: grid;
        grid-template-columns: 1fr;
        padding: 10% 10% 0 10%;
        background-color: var(--lightgreen);
        color: var(--green);
        font-family: var(--brodfont);
    }
    img {
        width: 600px;
        height: auto;
    }
    /*  */
    @media screen and (min-width: 768px) {
        footer {
            grid-template-columns: 2fr 1fr 1fr;
        }
    }
</style>
