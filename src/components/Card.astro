---
const { headline, text, image } = Astro.props;
import { Image } from "astro:assets";
---

<article>
    <div><Image src={image} alt="postkort" /></div>
    <h3>{headline}</h3>
    <p>{text}</p>
</article>

<style>
    article {
        max-width: 300px;
        margin-bottom: 3rem;
        justify-self: center;
    }

    div {
        width: 100%;
        margin-bottom: 0.5rem;
        background-color: #eee;
    }

    h3{
    font-family: var(--brodfont);
    font-weight: 600;

    }

    p{
        opacity: 0.4;
        font-family: var(--brodfont);
        
    }
</style>
